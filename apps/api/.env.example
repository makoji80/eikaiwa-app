# サーバーのポート
PORT=4000

# Prisma接続文字列。開発はSQLite（ゼロセットアップ）。本番はPostgres等への移行を想定。
# SQLiteの相対パスは schema.prisma のあるディレクトリ(prisma/)からの相対で解決される。
DATABASE_URL="file:./dev.db"

# JWT署名鍵。ランダムな文字列に変更すること（例: openssl rand -hex 32）。コミットしない。
JWT_SECRET=

# アクセストークンの有効期限（秒）。既定 43200 = 12時間。
JWT_EXPIRES_IN_SECONDS=43200

# mock（既定・外部通信なし）または openai
AI_PROVIDER=mock

# AI_PROVIDER=openai の場合のみ必須。コミットしない。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# モバイルアプリ(Expo dev server)からのCORSを許可するオリジン
CORS_ORIGIN=http://localhost:8081

# 冪等性レコードの有効期限（時間）
IDEMPOTENCY_TTL_HOURS=24
